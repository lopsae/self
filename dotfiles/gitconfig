[user]
	name = Maic Lopez Saenz
	email = maic@lopsae.com
	useConfigOnly = true
[push]
	default = tracking
[color]
	branch = auto
	status = auto
[color "branch"]
	current = green bold
	local = blue bold
	remote = magenta bold
[color "status"]
	header = normal
	added = yellow
	changed = blue bold
	untracked = magenta bold
	branch = green bold
	nobranch = red bold
[credential]
	# Used to store github credentials for connecting through https
	# https://help.github.com/articles/caching-your-github-password-in-git/
	helper = osxkeychain


# For Araxis Merge
# [diff]
	# tool = araxis
# [merge]
	# tool = araxis
# [mergetool]
# 	keepBackup = false


# For Kaleidoscope, as configured by Kaleidoscope app itself
[diff]
	tool = Kaleidoscope
[merge]
	tool = Kaleidoscope
[mergetool]
	keepBackup = false
	prompt = false
[difftool "Kaleidoscope"]
	cmd = ksdiff --partial-changeset --wait --relative-path \"$MERGED\" -- \"$LOCAL\" \"$REMOTE\"
[difftool]
	prompt = false
	trustExitCode = true
[mergetool "Kaleidoscope"]
	cmd = ksdiff --merge --output \"$MERGED\" --base \"$BASE\" -- \"$LOCAL\" --snapshot \"$REMOTE\" --snapshot
	trustExitCode = true
